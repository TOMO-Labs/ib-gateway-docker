# IB Gateway Docker - Environment Configuration
# Copy this file to .env and fill in your values
# SECURITY: Never commit .env file with real credentials to git!

#############################################################################
# TRADING MODE CONFIGURATION
#############################################################################

# Trading mode: "paper", "live", or "both"
# - paper: Paper trading only (recommended for testing)
# - live: Live trading only (real money)
# - both: Runs both paper and live instances simultaneously
TRADING_MODE=both

#############################################################################
# INTERACTIVE BROKERS CREDENTIALS
#############################################################################

# For TRADING_MODE=both, you need separate credentials:

# Paper trading account
TWS_USERID_PAPER=your_paper_username
TWS_PASSWORD_PAPER=your_paper_password

# Live trading account
TWS_USERID=your_live_username
TWS_PASSWORD=your_live_password

# For TRADING_MODE=paper or TRADING_MODE=live, only set TWS_USERID and TWS_PASSWORD:
# TWS_USERID=your_username
# TWS_PASSWORD=your_password

# Alternative: Use Docker secrets with _FILE suffix
# TWS_PASSWORD_FILE=/run/secrets/tws_password
# TWS_PASSWORD_PAPER_FILE=/run/secrets/tws_password_paper

#############################################################################
# TWO-FACTOR AUTHENTICATION (2FA)
#############################################################################

# Action when 2FA times out: "restart" or "exit"
TWOFA_TIMEOUT_ACTION=restart

# Re-login after 2FA timeout: "yes" or "no"
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# Time in seconds to wait before exiting due to 2FA timeout
TWOFA_EXIT_INTERVAL=60

# 2FA device type (optional): leave empty for default
TWOFA_DEVICE=

#############################################################################
# API CONFIGURATION
#############################################################################

# Accept incoming API connections: "accept", "reject", or "manual" (default: "manual")
# Recommended: leave empty to use default
TWS_ACCEPT_INCOMING=

# Master Client ID (optional): leave empty for no restriction
TWS_MASTER_CLIENT_ID=

# Read-only API mode: "yes" or "no"
READ_ONLY_API=no

# Allow blind trading (trading without visual confirmation): "yes" or "no"
ALLOW_BLIND_TRADING=no

#############################################################################
# SESSION MANAGEMENT
#############################################################################

# Action when existing session detected: "primary" or "secondary"
EXISTING_SESSION_DETECTED_ACTION=primary

# Auto-restart time (format: "HH:MM AM/PM" or "HH:MM:SS")
# Example: "11:59 PM" restarts just before midnight
AUTO_RESTART_TIME=11:59 PM

# Auto-logoff time (optional): leave empty to disable
AUTO_LOGOFF_TIME=

# Cold restart (completely restart Java process) at specified time (24-hour format: HH:MM)
# Example: "23:59" for Sunday cold restart. Leave empty to disable.
TWS_COLD_RESTART=

# Auto-save TWS settings at specified times (space-separated list)
# Example: "08:00 12:30 17:30" saves at 8am, 12:30pm, and 5:30pm
# Leave empty to disable auto-save
SAVE_TWS_SETTINGS=

#############################################################################
# TIMEZONE CONFIGURATION
#############################################################################

# Timezone for container (use IANA timezone format)
# Examples: America/New_York, America/Chicago, Europe/London, Asia/Hong_Kong
TIME_ZONE=America/New_York
TZ=America/New_York

#############################################################################
# VNC SERVER (for GUI access and debugging)
#############################################################################

# VNC password (leave empty to disable VNC)
# When set, you can connect to localhost:5900 to see the IB Gateway GUI
VNC_SERVER_PASSWORD=

#############################################################################
# ADVANCED CONFIGURATION
#############################################################################

# Custom configuration mode: "yes" or "no"
# When "yes", skips template processing and uses your custom config files
CUSTOM_CONFIG=no

# Java heap size in MB (optional): leave empty for default (768MB)
# Enter just the number, no units. Example: "2048" for 2GB
JAVA_HEAP_SIZE=

# IB Gateway settings path (advanced users only)
# Leave empty to use default paths (/home/ibgateway/Jts_live, /home/ibgateway/Jts_paper)
TWS_SETTINGS_PATH=

# Bypass warnings: "yes" or "no"
BYPASS_WARNING=no

#############################################################################
# STARTUP SCRIPTS (optional)
#############################################################################

# Paths to custom startup scripts directories
# Mount these as volumes in docker-compose.yml
# START_SCRIPTS=/home/ibgateway/START_SCRIPTS
# X_SCRIPTS=/home/ibgateway/X_SCRIPTS
# IBC_SCRIPTS=/home/ibgateway/IBC_SCRIPTS

#############################################################################
# DEPLOYMENT NOTES
#############################################################################

# 1. Security: This file contains sensitive credentials
#    - Never commit this file to git
#    - Set appropriate file permissions: chmod 600 .env
#    - Consider using Docker secrets (_FILE variables) for production

# 2. Remote Access (if needed):
#    - Use SSH port forwarding: ssh -L 4001:localhost:4001 -L 4002:localhost:4002 user@vps-ip -N
#    - Use VPN (WireGuard, OpenVPN, Tailscale)
#    - Use reverse proxy with authentication (Caddy, Traefik)

# 3. First-time login:
#    - IB may require you to approve the new login location
#    - Use IBKR Mobile app or IB website to approve
#    - Check logs: docker compose logs -f

# 4. API Ports (via HAProxy):
#    - Live trading: localhost:4001 on host → HAProxy → IB Gateway
#    - Paper trading: localhost:4002 on host → HAProxy → IB Gateway
#    - HAProxy stats: http://localhost:8404/stats (connection health monitoring)
