global
  # Process management
  maxconn 512
  master-worker
  nbthread 2

  # Logging to stdout (Docker logs)
  log stdout format raw local0 info

  # Stats socket for runtime management
  stats socket /tmp/haproxy.sock mode 600 level admin
  stats timeout 2m

defaults
  mode tcp
  log global
  option tcplog
  option tcpka

  # Connection timeouts (IB Gateway needs long timeouts for persistent connections)
  timeout connect 5s
  timeout client 6h
  timeout server 6h
  timeout check 2s

# Stats page for monitoring
listen stats
  bind 0.0.0.0:8404
  mode http
  stats enable
  stats uri /stats
  stats refresh 10s
  stats show-legends
  stats show-node
  # Basic auth for stats page (optional: set via environment variables)
  # stats auth ${HAPROXY_STATS_USER:-admin}:${HAPROXY_STATS_PASSWORD:-admin}

# LIVE TRADING (4001)
frontend ibg_live
  bind 0.0.0.0:4001
  maxconn 200
  default_backend ibg_live_backend

backend ibg_live_backend
  balance source
  option tcp-check

  # Health check: TCP connection test
  server ibglive 127.0.0.1:4001 check inter 2s fall 2 rise 1 maxconn 200

# PAPER TRADING (4002)
frontend ibg_paper
  bind 0.0.0.0:4002
  maxconn 200
  default_backend ibg_paper_backend

backend ibg_paper_backend
  balance source
  option tcp-check

  # Health check: TCP connection test
  server ibgpaper 127.0.0.1:4002 check inter 2s fall 2 rise 1 maxconn 200
